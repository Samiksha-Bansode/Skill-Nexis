import pandas as pd

df = pd.read_csv('data.csv')

df['Date'] = pd.to_datetime(df['Date'], format='mixed', errors='coerce')
df = df.dropna(subset=['Date'])

df['Calories'] = df['Calories'].fillna(df['Calories'].median())

df['Pulse'] = df['Pulse'].fillna(df['Pulse'].median())
df['Maxpulse'] = df['Maxpulse'].fillna(df['Maxpulse'].median())

df = df[df['Duration'] <= 120]

high_intensity_df = df[df['Pulse'] >= 100]

df['Pulse_range'] = df['Maxpulse'] - df['Pulse']

df['Calories_per_min'] = df['Calories'] / df['Duration']

df['Intensity_level'] = df['Maxpulse'].apply(
    lambda x: 'High' if x >= 150 else ('Moderate' if x >= 120 else 'Low')
)

print(df.head())




